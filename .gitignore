# Created by venv; see https://docs.python.org/3/library/venv.html


## 1. Remove the existing repo metadata
# rm -rf .git
## 2. Re-initialize
# git init
## 3. (Optional) Set default branch name
# git branch -M main
## 4. Add everything (respects your .gitignore)
# git add .
## 5. First commit
# git commit -m "Initial commit"


